rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidLanguage(lang) {
      return lang is string && (lang == 'en' || lang == 'hi');
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.displayName is string && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && isValidLanguage(data.preferredLanguage)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedAnalysis(data, userId, analysisId) {
      return data.keys().hasAll([
          'id', 'userId', 'language', 'type', 'summary',
          'deadlines', 'money', 'risks', 'steps', 'completedSteps',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'language', 'type', 'summary',
          'deadlines', 'money', 'risks', 'steps', 'completedSteps',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == analysisId && isValidId(data.id)
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid && isValidId(data.userId)
        && isValidLanguage(data.language)
        && data.type is string && data.type.size() >= 1 && data.type.size() <= 120
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 1600
        && data.deadlines is list && data.deadlines.size() <= 20
        && (data.deadlines.size() == 0 || data.deadlines[0] is map)
        && data.money is list && data.money.size() <= 20
        && (data.money.size() == 0 || data.money[0] is map)
        && data.risks is list && data.risks.size() <= 20
        && (data.risks.size() == 0 || data.risks[0] is map)
        && data.steps is list && data.steps.size() <= 20
        && (data.steps.size() == 0 || data.steps[0] is string)
        && data.completedSteps is list && data.completedSteps.size() <= 20
        && (data.completedSteps.size() == 0 || data.completedSteps[0] is number)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['preferredLanguage', 'updatedAt'])
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);

      match /analyses/{analysisId} {
        allow get: if isVerifiedUser() && isValidId(userId) && isValidId(analysisId) && isOwner(userId);
        allow list: if isVerifiedUser() && isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(analysisId)
          && isOwner(userId)
          && isValidSavedAnalysis(incoming(), userId, analysisId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(analysisId)
          && isOwner(userId)
          && isValidSavedAnalysis(incoming(), userId, analysisId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['completedSteps', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['language', 'type', 'summary', 'deadlines', 'money', 'risks', 'steps', 'updatedAt'])
          );
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(analysisId) && isOwner(userId);
      }
    }
  }
}
