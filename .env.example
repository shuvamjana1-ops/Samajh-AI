# ==============================================================================
# Samajh Environment Configuration Template
# Copy to `.env` for local development. Never commit `.env` or real secrets.
# ==============================================================================

# --- Free-Tier AI Providers (Server-Only — configure at least one in prod) ---
# Routing mode: "auto" (tries Gemini -> Groq -> OpenRouter -> Ollama) or force one provider.
AI_PROVIDER="auto"

# 1. Google Gemini Free Tier (Google AI Studio) — supports images AND PDFs
# Allowed models: "gemini-4-hydrogen" (default) or "gemini-3.1-flash-lite"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-4-hydrogen"

# 2. Groq Free Tier (OpenAI-compatible) — fast Llama 4 vision + Llama 3.3 text (JPG/PNG)
GROQ_API_KEY=""
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
GROQ_TEXT_MODEL="llama-3.3-70b-versatile"

# 3. OpenRouter `:free` Tier (OpenAI-compatible) — zero-cost community models (JPG/PNG)
OPENROUTER_API_KEY=""
OPENROUTER_VISION_MODEL="google/gemma-3-27b-it:free"
OPENROUTER_TEXT_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# 4. Local / Self-Hosted Ollama (100% free, zero API key required — JPG/PNG)
# Example: http://localhost:11434
OLLAMA_BASE_URL=""
OLLAMA_VISION_MODEL="llama3.2-vision"
OLLAMA_TEXT_MODEL="llama3.2"

# --- Server Runtime & Hosting -------------------------------------------------
NODE_ENV="development"
PORT="3000"
# Public canonical origin in production (e.g. https://samajh.example.com).
# AI Studio injects this automatically at runtime.
APP_URL="http://localhost:3000"
# Set to "true" only on your live production domain to allow search indexing.
ALLOW_INDEXING="false"
# Set to "true" to disable Vite HMR / file watching in hosted dev sandboxes.
DISABLE_HMR="false"

# --- AI Spend Caps & Kill Switch (Server-Only) --------------------------------
# Emergency kill switch: set to "true" to return 503 on /api/analyze, /api/translate, /api/ask.
DISABLE_PAID_AI="false"
# Daily UTC call limits enforced server-side before invoking AI providers (defaults: 500 global, 30/IP).
AI_DAILY_GLOBAL_LIMIT="500"
AI_DAILY_IP_LIMIT="30"

# --- Firebase Web Client Config (env-only; do not bundle config JSON) ---------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
